# Copy to deploy/.env on the server. Never commit deploy/.env.
APP_URL=https://16labs.xyz
SECRET_KEY=            # long random string, signs sessions: openssl rand -hex 32
CRON_SECRET=           # long random string, guards /api/cron/tick
COMPILE_API_KEY=       # OpenRouter key used only to compile one-sentence jobs into plans
NEXT_PUBLIC_WC_PROJECT_ID=   # WalletConnect project id (optional; MetaMask/Rabby work without it)
ANCHOR_PRIVATE_KEY=    # funded wallet on Robinhood Chain that writes run hashes (optional until funded)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=      # Google Cloud OAuth client (Web); redirect https://16labs.xyz/api/connections/gmail/callback; Gmail API enabled; scope gmail.modify
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
