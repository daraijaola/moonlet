# --- required in production ---
SECRET_KEY=                 # encrypts OpenRouter keys and Orbio tokens at rest
DATABASE_URL=file:./.data/moonlet.db   # or libsql://…turso.io
DATABASE_AUTH_TOKEN=
APP_URL=https://moonlet.16labs.xyz # public origin; used for OAuth redirects and links in reports
CRON_SECRET=                # Vercel cron sends Authorization: Bearer <CRON_SECRET>

# NEXT_PUBLIC_WC_PROJECT_ID=  # WalletConnect project id from cloud.reown.com (enables QR / mobile wallets)

# --- connections (each optional; the Connections page shows "not configured" without them) ---
TELEGRAM_BOT_TOKEN=         # from @BotFather. One bot for the platform; holders link by tapping Start.
TELEGRAM_BOT_USERNAME=      # e.g. MoonletBot (no @)
GITHUB_CLIENT_ID=           # GitHub OAuth App → "Connect GitHub" button. Callback: <APP_URL>/api/connections/github/callback
GITHUB_CLIENT_SECRET=       # without these, users can still paste a fine-grained token
GOOGLE_CLIENT_ID=           # Google Cloud OAuth client (Web) → "Connect Gmail". Callback: <APP_URL>/api/connections/gmail/callback. Gmail API on, scope gmail.modify
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=                # X developer app (OAuth 2.0, PKCE). Callback: <APP_URL>/api/connections/x/callback
X_CLIENT_SECRET=            # only for confidential X apps

# --- platform keys ---
COMPILE_API_KEY=            # OpenRouter key used only to compile sentences into specs (sub-cent per call)
ANCHOR_PRIVATE_KEY=         # Robinhood Chain wallet with a little ETH; pays ~$0.03/run to anchor
ORBIO_CLIENT_ID=            # optional; auto-registered via dynamic client registration if empty

# --- models (defaults shown) ---
# MODEL_COMPILE=google/gemini-3.8-flash
# MODEL_RUN_LOW=google/gemini-3.8-flash
# MODEL_RUN_MID=openai/gpt-5.6-terra
# MODEL_RUN_HIGH=anthropic/claude-sonnet-5
# MODEL_CODE=anthropic/claude-sonnet-5
# MODEL_FALLBACKS=google/gemini-3.8-flash,openai/gpt-5.6-terra,google/gemini-3.7-flash
# TICK_CONCURRENCY=4
# ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com

# --- local dev only ---
# ALLOW_HEADER_AUTH=1        # accept x-owner without a SIWE session (never in prod)
# skip Orbio OAuth and hand every owner this key:
# ALLOW_DEV_ORBIO=1
# ORBIO_DEV_KEY=sk-or-v1-…

# --- tests (tests/ hit real inference; ~$0.50 per full run) ---
# OPENROUTER_API_KEY=sk-or-v1-…
